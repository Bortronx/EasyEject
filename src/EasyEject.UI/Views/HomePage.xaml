<UserControl
    x:Class="EasyEject.UI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:EasyEject.UI.Converters"
    xmlns:vm="using:EasyEject.UI.ViewModels"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header                                                -->
        <Grid Grid.Row="0" Padding="36,24,36,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="EasyEject" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Safely eject external storage devices." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button
                    Style="{StaticResource IconButtonStyle}"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    AutomationProperties.Name="Refresh device list"
                    ToolTipService.ToolTip="Refresh device list">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
                <ComboBox
                    MinWidth="110"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedThemeOption, Mode=TwoWay}"
                    AutomationProperties.Name="Application theme">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThemeOption">
                            <TextBlock Text="{x:Bind Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Notifications                                         -->
        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            Margin="36,4,36,4"
            IsClosable="True"
            IsOpen="False" />

        <!-- Content                                               -->
        <Grid Grid.Row="2" Padding="36,0,36,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Primary action card -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="Choose the USB device you want to eject."
                            Style="{StaticResource BodyStrongTextStyle}" />
                        <TextBlock
                            Text="Each device now shows its drive letter so matching duplicate names is easier."
                            Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="20"
                            Padding="12,4">
                            <TextBlock
                                Text="{x:Bind ViewModel.DeviceCountText, Mode=OneWay}"
                                Style="{StaticResource CaptionTextStyle}"
                                FontWeight="SemiBold"
                                AutomationProperties.Name="Number of devices" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Section header -->
            <Grid Grid.Row="1" Margin="0,24,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Select a Device" Style="{StaticResource SectionHeaderTextStyle}" />
                <TextBlock
                    Grid.Column="1"
                    Text="Radio buttons select a single device"
                    Style="{StaticResource CaptionTextStyle}"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- Device list -->
            <Grid Grid.Row="2">
                <ListView
                    x:Name="DeviceList"
                    ItemsSource="{x:Bind ViewModel.Devices}"
                    SelectionMode="Single"
                    SelectionChanged="DeviceList_SelectionChanged"
                    AutomationProperties.Name="External devices"
                    Padding="0,4">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceItemViewModel">
                            <Grid Padding="0,10" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon tile -->
                                <Border
                                    Width="44"
                                    Height="44"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource IconTileBorderStyle}">
                                    <FontIcon
                                        Glyph="{x:Bind IconGlyph}"
                                        FontSize="20"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>

                                <!-- Device info -->
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        Style="{StaticResource BodyStrongTextStyle}"
                                        TextTrimming="CharacterEllipsis"
                                        AutomationProperties.Name="Device name" />
                                    <TextBlock
                                        Text="{x:Bind Subtitle, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Border
                                        HorizontalAlignment="Left"
                                        Margin="0,2,0,0"
                                        Padding="8,2"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <TextBlock
                                            Text="{x:Bind DriveLetterBadgeText, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextStyle}"
                                            FontWeight="SemiBold"
                                            AutomationProperties.Name="Drive letter" />
                                    </Border>
                                    <TextBlock
                                        Text="{x:Bind DetailText, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextStyle}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Capacity + radio -->
                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="14">
                                        <StackPanel>
                                            <TextBlock
                                                Text="Drive letter"
                                                Style="{StaticResource CaptionTextStyle}"
                                                HorizontalAlignment="Right"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind VolumeText, Mode=OneWay}"
                                                Style="{StaticResource BodyStrongTextStyle}"
                                                HorizontalAlignment="Right"
                                                AutomationProperties.Name="Drive letters" />
                                            <TextBlock
                                                Text="{x:Bind CapacityText, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextStyle}"
                                                HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <RadioButton
                                            GroupName="DeviceSelection"
                                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                            Checked="DeviceRadio_Checked"
                                            AutomationProperties.Name="{x:Bind Title, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state -->
                <StackPanel
                    Visibility="{x:Bind ViewModel.HasDevices, Converter={StaticResource InverseBoolToVisibility}, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="6"
                    IsHitTestVisible="False">
                    <FontIcon
                        Glyph="&#xE88E;"
                        FontSize="40"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="No external devices found."
                        Style="{StaticResource BodyStrongTextStyle}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="Connect a USB drive, card or external disk to get started."
                        Style="{StaticResource CaptionTextStyle}"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Eject selected -->
            <Button
                Grid.Row="3"
                Margin="0,12,0,4"
                Style="{StaticResource SecondaryActionButtonStyle}"
                Command="{x:Bind ViewModel.EjectSelectedCommand}"
                AutomationProperties.Name="Eject selected device">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE88E;" FontSize="14" />
                    <TextBlock Text="Eject Selected Device" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Status bar                                            -->
        <Border
            Grid.Row="3"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            Padding="36,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressRing
                    Width="14"
                    Height="14"
                    IsActive="{x:Bind ViewModel.ShowBusyIndicator, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ShowBusyIndicator, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />

                <TextBlock
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Style="{StaticResource CaptionTextStyle}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    AutomationProperties.Name="Status" />

                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind ViewModel.DeviceCountText, Mode=OneWay}"
                    Style="{StaticResource CaptionTextStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
