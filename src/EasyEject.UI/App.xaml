<Application
    x:Class="EasyEject.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Segoe UI Variable with graceful fallback to Segoe UI on older systems. -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
